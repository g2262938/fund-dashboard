{
  "title": "选股策略 v1 — simple_picker",
  "type": "flowchart",
  "nodes": [
    {"id": "0", "type": "start", "label": "启动 simple_picker.py"},
    {"id": "1", "type": "data", "label": "数据源:腾讯实时接口\\n(akshare 取股票池)"},

    {"id": "10", "type": "process", "label": "前置筛选:\\n剔除 ST / *ST / 北交所"},
    {"id": "11", "type": "process", "label": "行情过滤:\\n剔除 跌停(-10%)、涨停(>9.8%)"},
    {"id": "12", "type": "process", "label": "剔除无效:\\n当前价 ≤ 0、停牌"},

    {"id": "20", "type": "decision", "label": "四维评分\\n(满分 100)"},
    {"id": "21", "type": "process", "label": "趋势(25):\\n涨幅位置 0~3% = 20\\n3~6% = 25\\n6~9.5% = 22"},
    {"id": "22", "type": "process", "label": "动量(25):\\n涨 + 换手 1~15% = 22\\n涨 + 换手 ≥15% = 15\\n涨 + 换手<1% = 18\\n跌 = 10"},
    {"id": "23", "type": "process", "label": "量价(25):\\n成交量 >5万手 = 23\\n>1万 = 20\\n>2千 = 15\\n<2千 = 8"},
    {"id": "24", "type": "process", "label": "估值(25):\\nPE 0~30 = 23\\n30~60 = 18\\n60~100 = 13\\n≥100 = 8\\n亏损(<0) = 5"},

    {"id": "30", "type": "process", "label": "总分汇总:trend + momentum + volume + valuation"},
    {"id": "31", "type": "decision", "label": "总分 ≥ 70?"},
    {"id": "32", "type": "end", "label": "淘汰:不进 TOP10"},

    {"id": "40", "type": "process", "label": "按总分降序排序"},
    {"id": "41", "type": "process", "label": "取 TOP 10"},
    {"id": "50", "type": "process", "label": "生成报告:\\n综合选股-{date}.md\\n推荐-{date}.md"},

    {"id": "60", "type": "decision", "label": "微信推送?\\n(hermes send)"},
    {"id": "61", "type": "end", "label": "完成 ✅\\n(用户收到选股日报)"}
  ],
  "edges": [
    {"source": "0", "target": "1"},
